# Local development settings for Father Guido Fantasy Football
# Copy this file to .env.local and fill in the values you want to use locally.

# Optional: overrides the built-in fallback password.
APP_PASSWORD=fatherguido2026

# Optional but recommended if your Firebase project ID differs from the default.
FIREBASE_PROJECT_ID=fantasy-football-father-2f71e

# Choose ONE Firebase Admin credential method for local development:
# 1) Preferred: place your downloaded service account JSON at:
#    ./firebase-credentials.json
# 2) Alternative: paste the JSON as a single-line string below.
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
